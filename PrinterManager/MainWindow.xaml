<Window
    x:Class="PrinterManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavigationView  -->
        </Grid.RowDefinitions>

        <Grid x:Name="titleBar" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
                <ColumnDefinition x:Name="LeftDragColumn" Width="*" />
                <ColumnDefinition
                    x:Name="SearchColumn"
                    Width="4*"
                    MinWidth="220" />
                <ColumnDefinition
                    x:Name="RightDragColumn"
                    Width="*"
                    MinWidth="48" />
                <ColumnDefinition x:Name="AccountColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image
                x:Name="TitleBarIcon"
                Grid.Column="1"
                Width="22"
                Height="22"
                Margin="16,12,16,8"
                Source="/Assets/Icons/Square44x44Logo.targetsize-16.png" />
            <TextBlock
                x:Name="TitleBarTextBlock"
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind AppTitle}" />
            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                Grid.Column="4"
                MaxWidth="600"
                VerticalAlignment="Center"
                PlaceholderText="Search for printers, drivers, forms, etc..."
                QueryIcon="Find" />

        </Grid>

        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Custom Filters"
                    Icon="Filter"
                    Tag="CustomFiltersPage" />
                <NavigationViewItem Content="Printer Servers" Tag="PrinterServersPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Deployed Printers"
                    Icon="Print"
                    Tag="DeployedPrintersPage" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="Controls" Height="auto" />
                    <RowDefinition x:Name="Frame" Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Padding="8"
                        Orientation="Horizontal"
                        Spacing="4">
                        <DropDownButton
                            x:Name="ViewDropDownButton"
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ContentPresenter x:Name="SelectedIconPresenter" VerticalAlignment="Center" />
                                    <TextBlock
                                        Margin="0,-1,8,1"
                                        VerticalAlignment="Center"
                                        Text="View" />
                                </StackPanel>
                            </DropDownButton.Content>

                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Icon="Add" Text="Add/Remove Columns..." />

                                    <MenuFlyoutSeparator />

                                    <RadioMenuFlyoutItem
                                        Click="ViewMode_Click"
                                        GroupName="ViewMode"
                                        Text="Large Icons">
                                        <RadioMenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF12B;" />
                                        </RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>

                                    <RadioMenuFlyoutItem
                                        Click="ViewMode_Click"
                                        GroupName="ViewMode"
                                        Icon="ViewAll"
                                        Text="Small Icons" />

                                    <RadioMenuFlyoutItem
                                        Click="ViewMode_Click"
                                        GroupName="ViewMode"
                                        Icon="AllApps"
                                        Text="List" />

                                    <RadioMenuFlyoutItem
                                        x:Name="DefaultDetailsViewItem"
                                        Click="ViewMode_Click"
                                        GroupName="ViewMode"
                                        IsChecked="True"
                                        Text="Details">
                                        <RadioMenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xE065;" />
                                        </RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem Text="Customize..." />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" />
                                <TextBlock
                                    Margin="0,-1,8,1"
                                    VerticalAlignment="Center"
                                    Text="Remove" />
                            </StackPanel>
                        </Button>
                        <Button
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" />
                                <TextBlock
                                    Margin="0,-1,8,1"
                                    VerticalAlignment="Center"
                                    Text="Export" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Padding="8"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <FontIcon FontSize="14" Glyph="&#xE74A;" />
                        </Button>
                        <Button
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        </Button>
                        <Button
                            Height="36"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <FontIcon FontSize="14" Glyph="&#xE72A;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Frame x:Name="navFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>