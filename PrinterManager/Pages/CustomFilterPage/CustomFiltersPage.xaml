<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrinterManager.Pages.CustomFiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:PrinterManager.Pages.CustomFilterPage"
    xmlns:ctl="using:PrinterManager.Controls.Table"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrinterManager.Pages.CustomFilterPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:res="using:PrinterManager.Resources"
    xmlns:tvf="using:PrinterManager.Pages.CustomFilterPage.Components.TreeViewLeaf"
    xmlns:vm="using:PrinterManager.Pages.CustomFilterPage"
    x:Name="PageRoot"
    d:DataContext="{d:DesignInstance Type=converters:PrinterFilterModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StatusConverter x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="250"
                    MinWidth="200"
                    MaxWidth="500" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="8">
                <TreeView x:Name="FiltersTree" ItemsSource="{x:Bind FiltersList}">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="tvf:FilterLeaf">
                            <TreeViewItem Padding="-4,0,8,0" ItemsSource="{x:Bind Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontFamily="{Binding LeafIcon.Font, TargetNullValue={StaticResource SymbolThemeFontFamily}}"
                                            FontSize="16"
                                            Glyph="{Binding LeafIcon.Glyph}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding TotalItems}"
                                        Visibility="{Binding DisplayTotalItems}" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </StackPanel>
            <CommunityToolkit:GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />

            <ctl:DataTable
                x:Name="PrintersTable"
                Grid.Column="2"
                ItemsSource="{x:Bind PrinterFiltersList}">

                <ctl:TableColumn
                    Width="250"
                    Header="Printer Name"
                    SortDirection="Ascending"
                    SortPath="Name">
                    <ctl:TableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PrinterFilterModel">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="16"
                                    Glyph="{x:Bind res:Icons.Printer.Glyph}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ctl:TableColumn.CellTemplate>
                </ctl:TableColumn>

                <ctl:TableColumn
                    Width="180"
                    Header="Server / IP"
                    Path="ServerName" />

                <ctl:TableColumn
                    Width="120"
                    Header="Status"
                    SortPath="Status">
                    <ctl:TableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PrinterFilterModel">
                            <Border
                                Margin="-4,0,0,0"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Background}"
                                CornerRadius="12">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}"
                                    Text="{x:Bind Status, Mode=OneWay}" />
                            </Border>
                        </DataTemplate>
                    </ctl:TableColumn.CellTemplate>
                </ctl:TableColumn>

                <ctl:TableColumn
                    Width="220"
                    Header="Driver"
                    Path="DriverName" />

                <ctl:TableColumn
                    Width="220"
                    Header="Port"
                    Path="Port" />
            </ctl:DataTable>
        </Grid>
    </Grid>
</Page>
