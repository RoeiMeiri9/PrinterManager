<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrinterManager.Pages.CustomFiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctl="using:PrinterManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrinterManager.Pages.CustomFilterPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:PrinterManager.Pages.CustomFilterPage"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="RoundedHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="250"
                    MinWidth="200"
                    MaxWidth="500" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="8">
                <ListView
                    x:Name="SubNavListView"
                    Grid.Row="1"
                    SelectionChanged="SubNavListView_SelectionChanged"
                    SelectionMode="Single">

                    <ListViewItem x:Name="AllPrintersItem" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                                <TextBlock VerticalAlignment="Center" Text="All Printers" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="2" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="AllDriversItem" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                                <TextBlock VerticalAlignment="Center" Text="All Drivers" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="7" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="PrintersNotReady" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                                <TextBlock VerticalAlignment="Center" Text="Printers Not Ready" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="PrintersWithJobs" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                                <TextBlock VerticalAlignment="Center" Text="Printers With Jobs" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="" />
                        </Grid>
                    </ListViewItem>
                </ListView>
            </StackPanel>
            <CommunityToolkit:GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />



            <!--  Outer ScrollViewer: horizontal scrolling only  -->
            <ScrollViewer
                Grid.Column="2"
                Margin="16"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">

                <!--  Explicit width = sum of the columns, so the ScrollViewer has something to scroll  -->
                <Grid Width="{x:Bind ColumnSettings.TotalWidth, Mode=OneWay}" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  ================= HEADER =================  -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind ColumnSettings.NameColumnWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ColumnSettings.ServerColumnWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ColumnSettings.StatusColumnWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ColumnSettings.DriverColumnWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>

                        <!--  Name  -->
                        <Grid Grid.Column="0">
                            <Button Style="{StaticResource RoundedHeaderButtonStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Printer Name"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Rectangle
                                Width="1"
                                Margin="0,6"
                                HorizontalAlignment="Right"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                IsHitTestVisible="False" />
                            <prim:Thumb
                                Width="8"
                                HorizontalAlignment="Right"
                                ctl:ThumbCursor.ResizeCursor="True"
                                Background="Transparent"
                                DragDelta="ResizeThumb_DragDelta"
                                Tag="0" />
                        </Grid>

                        <!--  Server / IP  -->
                        <Grid Grid.Column="1" Visibility="{x:Bind ColumnSettings.ServerVisibility, Mode=OneWay}">
                            <Button Style="{StaticResource RoundedHeaderButtonStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Server / IP"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Rectangle
                                Width="1"
                                Margin="0,6"
                                HorizontalAlignment="Right"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                IsHitTestVisible="False" />
                            <prim:Thumb
                                Width="8"
                                HorizontalAlignment="Right"
                                ctl:ThumbCursor.ResizeCursor="True"
                                Background="Transparent"
                                DragDelta="ResizeThumb_DragDelta"
                                Tag="1" />
                        </Grid>

                        <!--  Status  -->
                        <Grid Grid.Column="2" Visibility="{x:Bind ColumnSettings.StatusVisibility, Mode=OneWay}">
                            <Button Style="{StaticResource RoundedHeaderButtonStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Status"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Rectangle
                                Width="1"
                                Margin="0,6"
                                HorizontalAlignment="Right"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                IsHitTestVisible="False" />
                            <prim:Thumb
                                Width="8"
                                HorizontalAlignment="Right"
                                ctl:ThumbCursor.ResizeCursor="True"
                                Background="Transparent"
                                DragDelta="ResizeThumb_DragDelta"
                                Tag="2" />
                        </Grid>

                        <!--  Driver  -->
                        <Grid Grid.Column="3" Visibility="{x:Bind ColumnSettings.DriverVisibility, Mode=OneWay}">
                            <Button Style="{StaticResource RoundedHeaderButtonStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Driver"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Rectangle
                                Width="1"
                                Margin="0,6"
                                HorizontalAlignment="Right"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                IsHitTestVisible="False" />
                            <prim:Thumb
                                Width="8"
                                HorizontalAlignment="Right"
                                ctl:ThumbCursor.ResizeCursor="True"
                                Background="Transparent"
                                DragDelta="ResizeThumb_DragDelta"
                                Tag="3" />
                        </Grid>
                    </Grid>

                    <!--  ================= ROWS =================  -->
                    <!--  The ListView scrolls vertically by itself; no inner ScrollViewer needed  -->
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind FiltersList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single">

                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterModel">
                                <Grid Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ColumnSettings.NameColumnWidth}" />
                                        <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ColumnSettings.ServerColumnWidth}" />
                                        <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ColumnSettings.StatusColumnWidth}" />
                                        <ColumnDefinition Width="{Binding ElementName=PageRoot, Path=ColumnSettings.DriverColumnWidth}" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Name  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  Server  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ServerName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding ElementName=PageRoot, Path=ColumnSettings.ServerVisibility}" />

                                    <!--  Status  -->
                                    <Border
                                        Grid.Column="2"
                                        Margin="12,0,12,0"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        Background="#4439822f"
                                        CornerRadius="12"
                                        Visibility="{Binding ElementName=PageRoot, Path=ColumnSettings.StatusVisibility}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind Status, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!--  Driver  -->
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind DriverName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding ElementName=PageRoot, Path=ColumnSettings.DriverVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
