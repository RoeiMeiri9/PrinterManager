<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrinterManager.Pages.CustomFiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:PrinterManager.Pages.CustomFilterPage"
    xmlns:ctl="using:PrinterManager.Controls.Table"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrinterManager.Pages.CustomFilterPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:PrinterManager.Pages.CustomFilterPage"
    x:Name="PageRoot"
    d:DataContext="{d:DesignInstance Type=converters:FilterModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StatusConverter x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="250"
                    MinWidth="200"
                    MaxWidth="500" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="8">
                <ListView
                    x:Name="SubNavListView"
                    Grid.Row="1"
                    SelectionChanged="SubNavListView_SelectionChanged"
                    SelectionMode="Single">

                    <ListViewItem x:Name="AllPrintersItem" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="16"
                                    Glyph="&#xE71C;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="All Printers"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="2" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="AllDriversItem" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="16"
                                    Glyph="&#xE71C;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="All Drivers"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="7" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="PrintersNotReady" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="16"
                                    Glyph="&#xE71C;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Printers Not Ready"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem x:Name="PrintersWithJobs" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="16"
                                    Glyph="&#xE71C;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Printers With Jobs"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="" />
                        </Grid>
                    </ListViewItem>
                </ListView>
            </StackPanel>
            <CommunityToolkit:GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />

            <ctl:DataTable
                x:Name="PrintersTable"
                Grid.Column="2"
                ItemsSource="{x:Bind FiltersList}">

                <ctl:TableColumn
                    Width="250"
                    Header="Printer Name"
                    SortDirection="Ascending"
                    SortPath="Name">
                    <ctl:TableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FilterModel">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    FontSize="16"
                                    Glyph="&#xE749;" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ctl:TableColumn.CellTemplate>
                </ctl:TableColumn>

                <ctl:TableColumn
                    Width="180"
                    Header="Server / IP"
                    Path="ServerName" />

                <ctl:TableColumn
                    Width="120"
                    Header="Status"
                    SortPath="Status">
                    <ctl:TableColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FilterModel">
                            <Border
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Background}"
                                CornerRadius="12">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}"
                                    Text="{x:Bind Status, Mode=OneWay}" />
                            </Border>
                        </DataTemplate>
                    </ctl:TableColumn.CellTemplate>
                </ctl:TableColumn>

                <ctl:TableColumn
                    Width="220"
                    Header="Driver"
                    Path="DriverName" />

                <ctl:TableColumn
                    Width="220"
                    Header="Port"
                    Path="Port" />
            </ctl:DataTable>
        </Grid>
    </Grid>
</Page>
